# Copie para .env e preencha. NUNCA versione o .env real.

SQL_SERVER=sql.exemplo.local
SQL_DATABASE=dw
SQL_DRIVER=ODBC Driver 17 for SQL Server

# Pasta onde o CSV é salvo, vista pelo script (cliente)...
CSV_DIR_CLIENTE=\\arquivos.exemplo.local\relatorios\carga
# ...e a MESMA pasta vista pelo servidor SQL, que é quem executa o BULK INSERT.
CSV_DIR_SERVIDOR=\\sql\relatorios\carga

TABELA_DESTINO=dw.dbo.historico_skill

# Extração web (portal de origem). Usuário e senha NUNCA vão no código.
PORTAL_URL=https://portal.exemplo.local/
PORTAL_USUARIO=
PORTAL_SENHA=

# Opcionais: use só se o Selenium não achar o Chrome/driver sozinho
# CHROME_BINARY=
# CHROMEDRIVER_PATH=
# CHROME_NO_SANDBOX=1   # contêineres e CI
